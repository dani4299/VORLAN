# DSRF Softech Studios - Apache settings for cPanel hosting.
# Upload this file to public_html, next to index.html. Every block is wrapped in <IfModule>, so a
# module your host does not have is skipped instead of breaking the site.

# ---------- Pages ----------
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

# ---------- HTTPS and www: turn ON after SSL is installed ----------
# 1. cPanel > SSL/TLS Status > run AutoSSL and wait until the domain shows a valid certificate.
# 2. Check https://www.dsrf.tech loads, then remove the leading "# " from the lines below.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off [OR]
#   RewriteCond %{HTTP_HOST} !^www\. [NC]
#   RewriteRule ^ https://www.dsrf.tech%{REQUEST_URI} [L,R=301]
# </IfModule>

# ---------- Keep development files private ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.(?!well-known) - [F,L]
</IfModule>
<FilesMatch "^_headers$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# ---------- File types ----------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType text/javascript .js
  AddCharset UTF-8 .html .css .js .txt .xml .webmanifest
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/xml application/json application/manifest+json image/svg+xml
</IfModule>

# ---------- Security headers ----------
# The Content-Security-Policy below was tested against every page.
# It allows only this site's own files, plus form posts to formsubmit.co.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self' https://formsubmit.co; frame-ancestors 'none'; base-uri 'self'"

  # Turn on once HTTPS works on every page (it tells browsers to always use HTTPS):
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # ---------- Caching ----------
  # File names are not versioned, so CSS and JS stay short-lived: edits show up within a day.
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpe?g|png|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
