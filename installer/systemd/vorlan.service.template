[Unit]
Description=VORLAN
# A user unit, not a system one - it runs as the account that owns its own
# data (secure_vault, secrets, Docker group membership), the same as running
# it by hand always has. `loginctl enable-linger` (set up by the installer)
# is what lets it start at boot without that account ever logging in.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__/backend
ExecStart=__NODE_BIN__ __INSTALL_DIR__/backend/server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
