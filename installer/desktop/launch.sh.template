#!/usr/bin/env bash
# Generated by the VORLAN installer - starts the hotspot, then opens VORLAN in the
# default browser. The backend itself is no longer started here: it's a systemd
# user service (installed and started once, at install time), so it's already
# running - even if this launcher, and every other desktop session, has never run.
set -e

INSTALL_DIR="__INSTALL_DIR__"
PORT="${PORT:-5000}"

# Start the hotspot (needs root - same mechanism as the manual pkexec create_ap
# command this replaces). Runs in the background; if it's already running,
# create_ap exits quickly on its own rather than erroring.
pkexec create_ap --config /etc/create_ap.conf >/tmp/vorlan-hotspot.log 2>&1 &

# The backend should already be running as the vorlan.service user unit. If it
# somehow isn't (disabled, or a first run before its own daemon-reload landed),
# ask systemd to start it rather than launching an unmanaged node process here.
if ! curl -s -o /dev/null "http://localhost:$PORT/api/system/connect-qr" 2>/dev/null; then
  systemctl --user start vorlan.service 2>/dev/null || true
fi

# Wait for the backend to come up, then open the browser.
for _ in $(seq 1 30); do
  if curl -s -o /dev/null "http://localhost:$PORT/" 2>/dev/null; then
    break
  fi
  sleep 0.5
done

if ! curl -s -o /dev/null "http://localhost:$PORT/" 2>/dev/null; then
  zenity --error --title="VORLAN" --text="VORLAN's background service isn't responding.\n\nCheck it with: systemctl --user status vorlan\nSee recent logs with: journalctl --user -u vorlan -e" 2>/dev/null || true
fi

xdg-open "http://localhost:$PORT/" >/dev/null 2>&1 &
