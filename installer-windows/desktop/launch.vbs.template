' Generated by the VORLAN Windows installer. This is what the desktop and Start Menu shortcuts
' actually point at - a plain .ps1 target still briefly flashes a console window even with
' -WindowStyle Hidden, so the shortcut points here instead, and this runs the real script with
' window style 0 (fully hidden) for a launch that looks like any other installed app.
Set fso = CreateObject("Scripting.FileSystemObject")
scriptDir = fso.GetParentFolderName(WScript.ScriptFullName)
launchPs1 = scriptDir & "\launch.ps1"

Set shell = CreateObject("WScript.Shell")
shell.Run "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File """ & launchPs1 & """", 0, False
