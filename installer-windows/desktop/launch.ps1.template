# Generated by the VORLAN Windows installer. Starts the backend if it isn't already running
# (checked by asking it directly, not by assuming a process is or isn't there), then opens VORLAN
# in the default browser. There is no Windows equivalent of the Linux side's systemd service in
# this installer - VORLAN only runs while something has launched it, the same as any other desktop
# app you open from the Start menu or a shortcut.

$InstallDir = "__INSTALL_DIR__"
$Port = 5000

function Test-VorlanUp {
    try {
        $response = Invoke-WebRequest -Uri "http://localhost:$Port/" -UseBasicParsing -TimeoutSec 2
        return $response.StatusCode -ge 200 -and $response.StatusCode -lt 500
    } catch {
        return $false
    }
}

if (-not (Test-VorlanUp)) {
    $node = (Get-Command node -ErrorAction SilentlyContinue).Source
    if (-not $node) {
        Add-Type -AssemblyName System.Windows.Forms
        [System.Windows.Forms.MessageBox]::Show(
            "Node.js isn't on PATH, so VORLAN's backend can't be started. Try reinstalling with installer-windows\install.ps1.",
            "VORLAN", "OK", "Error"
        ) | Out-Null
        exit 1
    }

    Start-Process -FilePath $node -ArgumentList "server.js" -WorkingDirectory (Join-Path $InstallDir "backend") -WindowStyle Hidden

    $waited = 0
    while (-not (Test-VorlanUp) -and $waited -lt 30) {
        Start-Sleep -Seconds 1
        $waited++
    }

    if (-not (Test-VorlanUp)) {
        Add-Type -AssemblyName System.Windows.Forms
        [System.Windows.Forms.MessageBox]::Show(
            "VORLAN's backend didn't respond after 30 seconds. Open a terminal in `"$InstallDir\backend`" and run `"node server.js`" to see what went wrong.",
            "VORLAN", "OK", "Error"
        ) | Out-Null
        exit 1
    }
}

Start-Process "http://localhost:$Port/"
